{
  "name": "@filarr/gate",
  "version": "0.3.1",
  "description": "Read and write the rows of a Filarr database opened to an API, from your own Node, Deno, Bun or Cloudflare Worker code, without Filarr ever seeing your data.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filarr-work/filarr-gate.git",
    "directory": "packages/gate"
  },
  "homepage": "https://github.com/filarr-work/filarr-gate#readme",
  "bugs": {
    "url": "https://github.com/filarr-work/filarr-gate/issues"
  },
  "keywords": [
    "filarr",
    "end-to-end encryption",
    "api",
    "database",
    "replica"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/gate/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/gate/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node ../../scripts/prepack.mjs LICENSE NOTICE"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "fflate": "^0.8.3"
  }
}
