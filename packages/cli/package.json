{
  "name": "filarr-gate",
  "version": "0.3.1",
  "description": "Serve a Filarr database as an API, without Filarr ever seeing your data: a customer-hosted replica of end-to-end encrypted Filarr database stores, with a local API, webhooks, MCP and a management UI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filarr-work/filarr-gate.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/filarr-work/filarr-gate#readme",
  "bugs": {
    "url": "https://github.com/filarr-work/filarr-gate/issues"
  },
  "keywords": [
    "filarr",
    "end-to-end encryption",
    "api",
    "database",
    "replica"
  ],
  "type": "module",
  "bin": {
    "filarr-gate": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "README.md",
    "README.fr.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "node scripts/build.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "start": "node dist/cli.js",
    "prepack": "node ../../scripts/prepack.mjs LICENSE NOTICE THIRD_PARTY_NOTICES README.md README.fr.md SECURITY.md"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "fflate": "^0.8.3",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "mysql2": "^3.24.5",
    "pg": "^8.23.1"
  }
}
