  "bumpDue": {
    "rule": "dernier retrait par magasin ; dû si non rouvert après, génération courante connue et égale à celle du retrait ; trié",
    "cases": [
      {
        "name": "retrait, génération inchangée : due",
        "candidates": [
          {
            "storeId": "Store00000000000000001",
            "g": 0,
            "at": "2026-10-10T01:00:00.000Z"
          }
        ],
        "current": {
          "Store00000000000000001": 0
        },
        "granted": {},
        "expected": [
          "Store00000000000000001"
        ]
      },
      {
        "name": "la montée faite : plus due",
        "candidates": [
          {
            "storeId": "Store00000000000000001",
            "g": 0,
            "at": "2026-10-10T01:00:00.000Z"
          }
        ],
        "current": {
          "Store00000000000000001": 1
        },
        "granted": {},
        "expected": []
      },
      {
        "name": "rouvert APRÈS le retrait : plus due",
